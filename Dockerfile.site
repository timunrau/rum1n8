FROM node:26-alpine AS builder

WORKDIR /workspace
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_UMAMI_SCRIPT_URL
ARG VITE_UMAMI_MARKETING_WEBSITE_ID
ARG VITE_APP_URL
ARG VITE_MARKETING_URL
ENV VITE_UMAMI_SCRIPT_URL=$VITE_UMAMI_SCRIPT_URL \
    VITE_UMAMI_MARKETING_WEBSITE_ID=$VITE_UMAMI_MARKETING_WEBSITE_ID \
    VITE_APP_URL=$VITE_APP_URL \
    VITE_MARKETING_URL=$VITE_MARKETING_URL

RUN npm run build:site \
    && test -f dist-site/index.html \
    && test -f dist-site/privacy/index.html \
    && test -f dist-site/marketing/screenshot-empty.png \
    && test -f dist-site/robots.txt \
    && test -f dist-site/sitemap.xml \
    && test ! -e dist-site/app/index.html \
    && test ! -e dist-site/manifest.webmanifest \
    && test ! -e dist-site/sw.js \
    && test ! -e dist-site/registerSW.js \
    && test ! -e dist-site/gdrive-callback.html

FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /workspace/dist-site/ /usr/share/nginx/html/
COPY nginx.site.conf /etc/nginx/conf.d/default.conf
RUN nginx -t

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
